# Leave DATABASE_URL unset locally to use SQLite (data/choir-festival.db).
# Configure Neon on Vercel using its pooled connection string.
# No local Postgres installation or test server is needed.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Admin portal at /admin. Set a strong, unique password to enable access.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
